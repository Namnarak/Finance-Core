{
  "id": "/",
  "name": "Finance Core",
  "short_name": "Finance",
  "description": "Private personal finance dashboard powered by Finance Core",
  "lang": "th",
  "dir": "auto",
  "start_url": "/#overview",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#090c11",
  "theme_color": "#090c11",
  "orientation": "any",
  "categories": ["finance", "productivity"],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "shortcuts": [
    {
      "name": "เพิ่มรายการ",
      "short_name": "เพิ่ม",
      "description": "เพิ่มรายรับหรือรายจ่ายอย่างรวดเร็ว",
      "url": "/?quick=1#overview",
      "icons": [{"src": "/app-icon-192.png?v=7", "sizes": "192x192", "type": "image/png"}]
    },
    {
      "name": "ประวัติรายการ",
      "short_name": "History",
      "url": "/#transactions",
      "icons": [{"src": "/app-icon-192.png?v=7", "sizes": "192x192", "type": "image/png"}]
    },
    {
      "name": "Spending Guard",
      "short_name": "Guard",
      "url": "/#guards",
      "icons": [{"src": "/app-icon-192.png?v=7", "sizes": "192x192", "type": "image/png"}]
    }
  ],
  "share_target": {
    "action": "/?share_target=1",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "icons": [
    {
      "src": "/app-icon-192.png?v=7",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/app-icon-512.png?v=7",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/app-icon-maskable-512.png?v=7",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
