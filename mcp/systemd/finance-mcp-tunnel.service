[Unit]
Description=OpenAI Secure MCP Tunnel - NamKrub Finance
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/finance-mcp/Finance.yaml
ConditionPathExists=/etc/finance-mcp/runtime.env

[Service]
Type=simple
User=finance-mcp
Group=finance-mcp
EnvironmentFile=/etc/finance-mcp/finance.env
EnvironmentFile=/etc/finance-mcp/runtime.env
ExecStart=/usr/local/bin/tunnel-client run --profile-file /etc/finance-mcp/Finance.yaml --log.level=info
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/finance-mcp /run

[Install]
WantedBy=multi-user.target
