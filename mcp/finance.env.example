FINANCE_DB_PATH=/var/lib/finance-mcp/finance.sqlite3
FINANCE_REPORT_DIR=/var/lib/finance-mcp/reports
FINANCE_TIMEZONE=Asia/Bangkok
FINANCE_CURRENCY=THB
# Optional: name or ID of the default account used when a transaction omits an account.
# Leave blank to require an explicit primary account setting in the database or fall back safely.
FINANCE_PRIMARY_ACCOUNT=
# Optional daily delivery destinations. Leave blank to generate report files only.
FINANCE_DISCORD_WEBHOOK=
FINANCE_TELEGRAM_BOT_TOKEN=
FINANCE_TELEGRAM_CHAT_ID=
